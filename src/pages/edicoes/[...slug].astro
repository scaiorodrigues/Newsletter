---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const edicoes = await getCollection('edicoes');
  return edicoes.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' });
---

<Base title={`Edição ${entry.data.edicao} — Alumínio em Perfil`}>
  <p><a href="/">← Todas as edições</a></p>

  <div class="edicao-head">
    <span class="num">Edição {entry.data.edicao}</span>
    <div class="edicao-titulo">{fmt(entry.data.data)}</div>
  </div>

  <article class="prosa">
    <Content />
  </article>
</Base>
