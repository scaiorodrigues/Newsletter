---
import '../styles/global.css';
import { link } from '../lib/newsletters';
import assinatura from '../../data/assinatura.json';

interface Props {
  title: string;
  description?: string;
  rss?: string;
}

const {
  title,
  description = 'Newsletters técnicas da FromTech para o setor industrial.',
  rss,
} = Astro.props;

const assinarUrl = assinatura.url;
const whatsappUrl = assinatura.whatsapp;
const assinantes = assinatura.assinantes;
// A UI de assinatura só aparece quando há uma URL real configurada
// (fica dormente até o provedor de e-mail ser definido).
const mostrarAssinatura = Boolean(assinarUrl && !assinarUrl.includes('exemplo'));
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800;900&display=swap"
    />
    {
      rss && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={title}
          href={new URL(link(rss), Astro.site)}
        />
      )
    }
    <title>{title}</title>
    <script is:inline>
      // Define o tema antes da primeira pintura, evitando flash.
      (function () {
        try {
          var salvo = localStorage.getItem('tema');
          var tema =
            salvo ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
          document.documentElement.dataset.theme = tema;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <div>
          <a class="brand" href="https://fromtech.com.br" target="_blank" rel="noopener"
            >FROMTECH</a
          >
          <a class="site-title" href={link('')}>Newsletters</a>
        </div>
        <div class="header-acoes">
          {mostrarAssinatura && <a class="btn-assinar" href={assinarUrl}>Assinar</a>}
          <button
            id="tema-toggle"
            class="tema-toggle"
            type="button"
            aria-label="Alternar tema claro e escuro"
          >
            <span class="tema-escuro">☾ Escuro</span>
            <span class="tema-claro">☀ Claro</span>
          </button>
        </div>
      </div>
    </header>

    <main class="wrap">
      <slot />

      {mostrarAssinatura && (
      <section class="assinar-cta">
        <h2 class="assinar-titulo">Receba cada edição no seu e-mail</h2>
        <p class="assinar-sub">
          Curadoria quinzenal sobre alumínio e manufatura de perfis — direto na
          sua caixa de entrada.
        </p>
        <div class="assinar-botoes">
          <a class="btn-assinar btn-grande" href={assinarUrl}>Assinar a newsletter</a>
          {
            whatsappUrl && (
              <a
                class="btn-whats"
                href={whatsappUrl}
                target="_blank"
                rel="noopener"
              >
                Receba no WhatsApp
              </a>
            )
          }
        </div>
      </section>
      )}
    </main>

    <footer class="site-footer">
      <div class="wrap">
        {
          assinantes != null && (
            <p class="assinantes">
              <strong>{assinantes.toLocaleString('pt-BR')}</strong> assinantes
            </p>
          )
        }
        <p class="footer-credito">
          Curadoria e edição:
          <a href="https://www.linkedin.com/company/121613929/" target="_blank" rel="noopener"
            >FromTech</a
          >
          {rss && <> · <a href={link(rss)}>RSS</a></>}
        </p>
      </div>
    </footer>

    <script is:inline>
      var btn = document.getElementById('tema-toggle');
      if (btn) {
        btn.addEventListener('click', function () {
          var atual =
            document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
          var proximo = atual === 'dark' ? 'light' : 'dark';
          document.documentElement.dataset.theme = proximo;
          try {
            localStorage.setItem('tema', proximo);
          } catch (e) {}
        });
      }
    </script>
  </body>
</html>
